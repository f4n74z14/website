---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import {
  Header,
  Breadcrumb,
  Main,
  Pagination,
  Footer,
  MusicPlayer,
} from "@/components";
import type { Locale } from "@/i18n";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  localeAlternates?: Partial<Record<Locale, string>>;
  pageTitle: string | [string, string];
  pageDesc?: string;
  mainClass?: string;
  page?: Page<CollectionEntry<"posts">>;
  showBreadcrumb?: boolean;
  withMusicPlayer?: boolean;
};

const {
  title,
  description,
  ogImage,
  canonicalURL,
  localeAlternates,
  pageTitle,
  pageDesc,
  mainClass,
  page,
  showBreadcrumb = true,
  withMusicPlayer = false,
} = Astro.props;
---

<Layout {title} {description} {ogImage} {canonicalURL} {localeAlternates}>
  <Header {localeAlternates} />

  {showBreadcrumb && <Breadcrumb />}

  <Main {pageTitle} {pageDesc} class={mainClass}>
    <slot />
  </Main>

  {page && <Pagination {page} />}

  <Footer noMarginTop={page ? page.lastPage > 1 : false} />
  {withMusicPlayer && <MusicPlayer />}
</Layout>
