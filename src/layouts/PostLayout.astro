---
import Layout from "./Layout.astro";
import { Header, Footer, MusicPlayer } from "@/components";
import BackButton from "@/pages/[...locale]/posts/[...slug]/_components/BackButton.astro";
import { resolveLocale, useTranslations, type Locale } from "@/i18n";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  localeAlternates?: Partial<Record<Locale, string>>;
  pubDatetime?: Date;
  modDatetime?: Date | null;
};

const { site } = config;
const locale = resolveLocale(Astro.currentLocale ?? site.lang);
const t = useTranslations(locale);

const {
  title,
  description,
  ogImage,
  canonicalURL,
  localeAlternates,
  pubDatetime,
  modDatetime,
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title ?? t.site.title,
  image: ogImage,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};

// JSON.stringify leaves `<` alone, so a title containing `</script>` would
// end the ld+json block early. `\u003c` reads back as `<` for JSON parsers.
const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c"
);
---

<Layout
  {title}
  {description}
  {ogImage}
  {canonicalURL}
  {localeAlternates}
  ogType="article"
>
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJson}
    />
  </Fragment>

  <div class="progress-container bg-background fixed top-0 z-10 h-1 w-full">
    <div class="progress-bar bg-accent h-1 w-0" id="myBar"></div>
  </div>

  <Header {localeAlternates} />

  <BackButton />

  <slot />

  <Footer />
  <MusicPlayer />
</Layout>
