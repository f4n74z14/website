---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { Header, Breadcrumb, Main, Footer } from "@/components";
import config from "@/config";

const thanks = await getEntry("pages", "thanks");

if (!thanks) {
  throw new Error(
    "Missing content entry: `thanks.md` or `thanks.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(thanks);
---

<Layout
  title={`${thanks.data.title} | ${config.site.title}`}
  description={thanks.data.description}
  ogImage={thanks.data.ogImage}
  canonicalURL={thanks.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={thanks.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
