---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { GetStaticPathsOptions } from "astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { Card } from "@/components";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import {
  LOCALES,
  getContentLocale,
  getLocaleParam,
  resolveLocale,
  useTranslations,
  type Locale,
} from "@/i18n";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tagsByLocale = new Map<
    Locale,
    ReturnType<typeof getUniqueTags>
  >();
  const postsByLocale = new Map<Locale, typeof posts>();

  for (const locale of LOCALES) {
    const localePosts = posts.filter(post => getContentLocale(post) === locale);
    postsByLocale.set(locale, localePosts);
    tagsByLocale.set(locale, getUniqueTags(localePosts));
  }

  return LOCALES.flatMap(locale => {
    const localePosts = postsByLocale.get(locale) ?? [];
    const tags = tagsByLocale.get(locale) ?? [];

    return tags.flatMap(({ tag, tagName }) => {
      const tagPosts = getSortedPosts(
        localePosts.filter(({ data }) => slugifyAll(data.tags).includes(tag))
      );
      const localeAlternates: Partial<Record<Locale, string>> = {};
      for (const loc of LOCALES) {
        const hasTag = tagsByLocale.get(loc)?.some(item => item.tag === tag);
        localeAlternates[loc] = hasTag
          ? getRelativeLocaleUrl(loc, `tags/${tag}`)
          : getRelativeLocaleUrl(loc, "tags");
      }

      return paginate(tagPosts, {
        params: { locale: getLocaleParam(locale), tag },
        props: { tagName, localeAlternates },
        pageSize: config.posts.perPage,
      });
    });
  });
}

const { page, tagName, localeAlternates } = Astro.props;

const locale = resolveLocale(Astro.currentLocale ?? config.site.lang);
const t = useTranslations(locale);
---

<PageLayout
  title={`${t.pages.tagTitle}: ${tagName} | ${t.site.title}`}
  pageTitle={`${t.pages.tagTitle}: ${tagName}`}
  pageDesc={`${t.pages.tagDesc} "${tagName}".`}
  {localeAlternates}
  {page}
>
  <ul>
    {page.data.map(data => (
      <Card {...data} />
    ))}
  </ul>
</PageLayout>
