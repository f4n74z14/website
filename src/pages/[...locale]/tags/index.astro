---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import { Tag } from "@/components";
import { getUniqueTags } from "@/utils/getUniqueTags";
import {
  getContentLocale,
  getStaticLocalePaths,
  resolveLocale,
  useTranslations,
} from "@/i18n";
import config from "@/config";

export const getStaticPaths = () => getStaticLocalePaths();

const locale = resolveLocale(Astro.currentLocale ?? config.site.lang);
const t = useTranslations(locale);

const posts = await getCollection(
  "posts",
  post => !post.data.draft && getContentLocale(post) === locale
);
const tags = getUniqueTags(posts);
---

<PageLayout
  title={`${t.pages.tagsTitle} | ${t.site.title}`}
  pageTitle={t.pages.tagsTitle}
  pageDesc={t.pages.tagsDesc}
>
  <ul class="flex flex-wrap gap-6">
    {tags.map(({ tag, tagName }) => (
      <Tag {tag} {tagName} />
    ))}
  </ul>
</PageLayout>
