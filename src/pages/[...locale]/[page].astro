---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PageLayout from "@/layouts/PageLayout.astro";
import {
  LOCALES,
  getContentLocale,
  getLocaleParam,
  resolveLocale,
  splitLocaleFromId,
  useTranslations,
  type Locale,
} from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  const slugsByLocale = new Map<Locale, Set<string>>();
  for (const entry of pages) {
    const entryLocale = getContentLocale(entry);
    const { slug } = splitLocaleFromId(entry.id);
    if (!slugsByLocale.has(entryLocale)) {
      slugsByLocale.set(entryLocale, new Set());
    }
    slugsByLocale.get(entryLocale)?.add(slug);
  }

  return pages.map(entry => {
    const entryLocale = getContentLocale(entry);
    const { slug } = splitLocaleFromId(entry.id);
    const localeAlternates: Partial<Record<Locale, string>> = {};
    for (const loc of LOCALES) {
      localeAlternates[loc] = slugsByLocale.get(loc)?.has(slug)
        ? getRelativeLocaleUrl(loc, slug)
        : getRelativeLocaleUrl(loc, "");
    }
    return {
      params: { locale: getLocaleParam(entryLocale), page: slug },
      props: { entry, slug, localeAlternates },
    };
  });
}

const { entry, slug, localeAlternates } = Astro.props;
const locale = resolveLocale(Astro.currentLocale ?? config.site.lang);
const t = useTranslations(locale);
const { Content } = await render(entry);
---

<PageLayout
  title={`${entry.data.title} | ${t.site.title}`}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  canonicalURL={entry.data.canonicalURL}
  {localeAlternates}
  pageTitle={entry.data.title}
  mainClass="app-prose"
  withMusicPlayer={entry.data.musicPlayer ?? slug === "about"}
>
  <Content />
</PageLayout>
