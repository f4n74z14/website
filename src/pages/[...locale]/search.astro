---
import { getRelativeLocaleUrl } from "astro:i18n";
import "@pagefind/default-ui/css/ui.css";
import PageLayout from "@/layouts/PageLayout.astro";
import { getAssetPath } from "@/utils/withBase";
import {
  getStaticLocalePaths,
  resolveLocale,
  useTranslations,
} from "@/i18n";
import config from "@/config";

export const getStaticPaths = () => getStaticLocalePaths();

const locale = resolveLocale(Astro.currentLocale ?? config.site.lang);

// Redirect to 404 page if `search` feature is not enabled
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search !== "pagefind" && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const backUrl = config.features.showBackButton
  ? `${Astro.url.pathname}`
  : getRelativeLocaleUrl(locale, "");

const pagefindBundlePath = getAssetPath("pagefind/");
const t = useTranslations(locale);
const pagefindTranslations = {
  placeholder: t.a11y.searchPlaceholder,
  search_label: t.search.label,
  clear_search: t.search.clear,
  searching: t.search.searching,
  zero_results: t.search.zeroResults,
  one_result: t.search.oneResult,
  many_results: t.search.manyResults,
  load_more: t.search.loadMore,
};
---

<PageLayout
  title={`${t.pages.searchTitle} | ${t.site.title}`}
  pageTitle={t.pages.searchTitle}
  pageDesc={t.pages.searchDesc}
>
  <div
    id="pagefind-search"
    transition:persist={`pagefind-search-${locale}`}
    data-locale={locale}
    data-backurl={backUrl}
    data-bundle-path={pagefindBundlePath}
    data-translations={JSON.stringify(pagefindTranslations)}
    data-dev-title={t.pages.searchDevWarningTitle}
    data-dev-body={t.pages.searchDevWarningBody}
  >
  </div>
</PageLayout>

<script>
  import { setBackUrl } from "@/scripts/navigation";

  let activeSearch: { destroy: () => void } | null = null;
  let activeBundlePath: string | null = null;
  let activeLocale: string | null = null;
  let initSeq = 0;

  function initSearch() {
    const pageFindSearch = document.querySelector<HTMLElement>("#pagefind-search");
    if (!pageFindSearch || pageFindSearch.querySelector("form")) return;

    const bundlePath = pageFindSearch.dataset.bundlePath;
    if (!bundlePath) return;

    const currentLocale =
      pageFindSearch.dataset.locale ?? document.documentElement.lang;
    const seq = ++initSeq;

    let translations: Record<string, string> | undefined;
    try {
      if (pageFindSearch.dataset.translations) {
        translations = JSON.parse(pageFindSearch.dataset.translations);
      }
    } catch {
      translations = undefined;
    }

    const params = new URLSearchParams(window.location.search);
    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    onIdle(async () => {
      if (
        seq !== initSeq ||
        !pageFindSearch.isConnected ||
        pageFindSearch.querySelector("form")
      ) {
        return;
      }

      if (activeSearch) {
        activeSearch.destroy();
        activeSearch = null;
      }

      if (activeLocale && activeLocale !== currentLocale && activeBundlePath) {
        try {
          const pfUrl = new URL(
            `${activeBundlePath}pagefind.js`,
            window.location.origin
          ).href;
          const pf = (await import(/* @vite-ignore */ pfUrl)) as {
            destroy?: () => Promise<void>;
          };
          await pf.destroy?.();
        } catch {
          // Ignore if Pagefind has not been initialized yet.
        }
      }

      if (seq !== initSeq || !pageFindSearch.isConnected) return;

      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");

      if (seq !== initSeq || !pageFindSearch.isConnected) return;

      if (import.meta.env.DEV) {
        const warning = document.createElement("div");
        warning.className = "bg-muted/75 rounded p-4 space-y-4 mb-4";
        const p = document.createElement("p");
        const strong = document.createElement("strong");
        strong.textContent = `${pageFindSearch.dataset.devTitle ?? "DEV mode Warning!"} `;
        p.append(strong, pageFindSearch.dataset.devBody ?? "");
        const code = document.createElement("code");
        code.className = "block bg-black text-white px-2 py-1 rounded";
        code.textContent = "npm run build";
        warning.append(p, code);
        pageFindSearch.replaceChildren(warning);
      }

      const search = new PagefindUI({
        element: "#pagefind-search",
        bundlePath,
        showImages: false,
        showSubResults: true,
        translations,
        processTerm: function (term: string) {
          params.set("q", term);
          history.replaceState(history.state, "", "?" + params.toString());

          const backUrl =
            pageFindSearch.dataset.backurl ?? window.location.pathname;
          setBackUrl(`${backUrl}?${params.toString()}`);

          return term;
        },
      });

      activeSearch = search;
      activeBundlePath = bundlePath;
      activeLocale = currentLocale;

      const query = params.get("q");
      if (query) {
        search.triggerSearch(query);
      }

      const searchInput = document.querySelector(".pagefind-ui__search-input");
      const clearButton = document.querySelector(".pagefind-ui__search-clear");
      searchInput?.addEventListener("input", resetSearchParam);
      clearButton?.addEventListener("click", resetSearchParam);

      function resetSearchParam(e: Event) {
        if ((e.target as HTMLInputElement)?.value.trim() === "") {
          history.replaceState(history.state, "", window.location.pathname);
        }
      }
    });
  }

  document.addEventListener("astro:page-load", initSearch);
</script>

<style is:global>
  #pagefind-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;

    form::before {
      background-color: var(--foreground);
    }

    input {
      font-weight: 400;
      border: 1px solid var(--border);
      transition:
        border-color var(--duration-ui) var(--ease-out-expo),
        box-shadow var(--duration-ui) var(--ease-out-expo);
    }

    input:focus-visible {
      outline: 1px solid var(--accent);
    }

    .pagefind-ui__result {
      animation: page-enter 200ms var(--ease-out-expo) both;
    }

    .pagefind-ui__result-title a {
      color: var(--accent);
      outline-offset: 1px;
      outline-color: var(--accent);
      text-decoration-style: dashed;
      text-underline-offset: 4px;
    }

    .pagefind-ui__result-title a:focus-visible,
    .pagefind-ui__search-clear:focus-visible {
      text-decoration-line: none;
      outline-width: 2px;
      outline-style: dashed;
    }

    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:before {
      font-family: system-ui;
    }

    mark {
      background-color: var(--accent);
      color: var(--accent-foreground);
      padding-inline: 0.15em;
      border-radius: 0.1875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #pagefind-search input {
      transition: none !important;
    }
    #pagefind-search .pagefind-ui__result {
      animation: none !important;
    }
  }
</style>
