---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import { Card } from "@/components";
import { getSortedPosts } from "@/utils/getSortedPosts";
import {
  LOCALES,
  getContentLocale,
  getLocaleParam,
  resolveLocale,
  useTranslations,
} from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return LOCALES.flatMap(locale => {
    const localePosts = getSortedPosts(
      posts.filter(post => getContentLocale(post) === locale)
    );
    return paginate(localePosts, {
      params: { locale: getLocaleParam(locale) },
      pageSize: config.posts.perPage,
    });
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const locale = resolveLocale(Astro.currentLocale ?? config.site.lang);
const t = useTranslations(locale);
---

<PageLayout
  title={`${t.pages.postsTitle} | ${t.site.title}`}
  pageTitle={t.pages.postsTitle}
  pageDesc={t.pages.postsDesc}
  {page}
>
  <ul>
    {page.data.map(data => (
      <Card {...data} />
    ))}
  </ul>
</PageLayout>
