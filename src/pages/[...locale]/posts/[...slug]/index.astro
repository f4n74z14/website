---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  LOCALES,
  getContentLocale,
  getLocaleParam,
  resolveLocale,
  tplStr,
  useTranslations,
  type Locale,
} from "@/i18n";
import PostLayout from "@/layouts/PostLayout.astro";
import { Datetime, Tag } from "@/components";
import { getPostSlug, getPostSlugPath, getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { buildTocTree, hasToc } from "@/utils/buildTocTree";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import EditPost from "./_components/EditPost.astro";
import BackToTopButton from "./_components/BackToTopButton.astro";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import PostToc from "./_components/PostToc.astro";
import PostEnd from "@/custom/PostEnd.astro";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedByLocale = new Map<Locale, CollectionEntry<"posts">[]>();
  const slugsByLocale = new Map<Locale, Set<string>>();

  for (const locale of LOCALES) {
    const localePosts = getSortedPosts(
      posts.filter(post => getContentLocale(post) === locale)
    );
    sortedByLocale.set(locale, localePosts);
    slugsByLocale.set(
      locale,
      new Set(localePosts.map(p => getPostSlugPath(p.id, p.filePath)))
    );
  }

  return LOCALES.flatMap(locale => {
    const sortedPosts = sortedByLocale.get(locale) ?? [];
    return sortedPosts.map((post, index) => {
      const slugPath = getPostSlugPath(post.id, post.filePath);
      const localeAlternates: Partial<Record<Locale, string>> = {};
      for (const loc of LOCALES) {
        localeAlternates[loc] = slugsByLocale.get(loc)?.has(slugPath)
          ? getRelativeLocaleUrl(loc, `posts/${slugPath}`)
          : getRelativeLocaleUrl(loc, "posts");
      }

      return {
        params: {
          locale: getLocaleParam(locale),
          slug: getPostSlug(post.id, post.filePath),
        },
        props: {
          post,
          localeAlternates,
          // sortedPosts is newest-first, so "older" (prev) is a higher index
          // and "newer" (next) is a lower index.
          prevPost:
            index < sortedPosts.length - 1
              ? {
                  id: sortedPosts[index + 1].id,
                  title: sortedPosts[index + 1].data.title,
                  filePath: sortedPosts[index + 1].filePath,
                }
              : null,
          nextPost:
            index > 0
              ? {
                  id: sortedPosts[index - 1].id,
                  title: sortedPosts[index - 1].data.title,
                  filePath: sortedPosts[index - 1].filePath,
                }
              : null,
        },
      };
    });
  });
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  localeAlternates: Partial<Record<Locale, string>>;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, localeAlternates, prevPost, nextPost } = Astro.props;
const locale = resolveLocale(Astro.currentLocale ?? config.site.lang);
const t = useTranslations(locale);

const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  hideToc,
} = post.data;

const { Content, headings } = await render(post);
const tocItems =
  config.features.toc && !hideToc && hasToc(headings)
    ? buildTocTree(headings)
    : [];

let ogImageUrl: string | undefined;
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );
  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const clientStrings = {
  copy: t.a11y.copyCode,
  copied: t.a11y.codeCopied,
  zoomImage: t.a11y.zoomImage,
  zoomImageGeneral: t.a11y.zoomImageGeneral,
  imagePreviewGeneral: t.a11y.imagePreviewGeneral,
  imagePreview: tplStr(t.a11y.imagePreview, { alt: "{{alt}}" }),
  closeImagePreview: t.a11y.closeImagePreview,
  linkToSection: tplStr(t.a11y.linkToSection, { title: "{{title}}" }),
};
---

<PostLayout
  title={`${title} | ${t.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  {localeAlternates}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <main
    id="main-content"
    class:list={["app-layout", { "mt-8": !config.features.showBackButton }]}
    data-pagefind-body
  >
    <h1
      style={{ viewTransitionName: toTransitionName(post.id) }}
      class="text-accent inline-block text-2xl font-bold sm:text-3xl"
    >
      {title}
    </h1>

    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span
        aria-hidden="true"
        class:list={[
          "text-muted-foreground max-sm:hidden",
          { hidden: !config.features.editPost?.enabled || hideEditPost },
        ]}
      >
        |
      </span>
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>

    <div class="post-body mt-8">
      <PostToc items={tocItems} />
      <article
        id="article"
        data-i18n={JSON.stringify(clientStrings)}
        class:list={[
          "w-full",
          "app-prose max-w-app",
          "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
        ]}
      >
        <Content />
      </article>
    </div>

    <hr class="my-8 border-dashed" />

    <BackToTopButton items={tocItems} />

    <div class="sm:my-8 sm:flex sm:items-start sm:justify-between sm:gap-8">
      <div class="mt-4 mb-8 flex items-start justify-between gap-4 sm:my-0">
        <ul class="flex flex-wrap gap-4">
          {tags.map(tag => (
            <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
          ))}
        </ul>
        <EditPost class="flex-none sm:hidden" {hideEditPost} {post} />
      </div>
    </div>

    <div data-pagefind-ignore>
      <PostEnd {post} />
    </div>

    <hr class="my-8 border-dashed" />

    <AdjacentPostNav {prevPost} {nextPost} />
  </main>
</PostLayout>

<script>
  import "@/scripts/post";
</script>
