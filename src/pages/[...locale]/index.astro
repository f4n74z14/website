---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import { Header, Footer, Card, LinkButton } from "@/components";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getAssetPath } from "@/utils/withBase";
import {
  getContentLocale,
  getStaticLocalePaths,
  resolveLocale,
  useTranslations,
} from "@/i18n";
import config from "@/config";

export const getStaticPaths = () => getStaticLocalePaths();

const { posts: postsConfig } = config;
const locale = resolveLocale(Astro.currentLocale ?? config.site.lang);
const t = useTranslations(locale);

const posts = (await getCollection("posts")).filter(
  post => getContentLocale(post) === locale
);
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "") || getAssetPath("");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-backurl={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {t.home.heroTitle}
      </h1>
      <div class="space-y-4">
        {t.home.heroParagraphs.map(paragraph => <p>{paragraph}</p>)}
      </div>
    </section>

    {featuredPosts.length > 0 && (
      <section
        id="featured"
        class:list={[
          "pt-12 pb-6",
          { "border-border border-b": recentPosts.length > 0 },
        ]}
      >
        <h2 class="text-2xl font-semibold tracking-wide">{t.home.featured}</h2>
        <ul>
          {featuredPosts.map(data => (
            <Card variant="h3" {...data} />
          ))}
        </ul>
      </section>
    )}

    {recentPosts.length > 0 && (
      <section id="recent-posts" class="pt-12 pb-6">
        <h2 class="text-2xl font-semibold tracking-wide">
          {t.home.recentPosts}
        </h2>
        <ul>
          {recentPosts.slice(0, postsConfig.perIndex).map(data => (
            <Card variant="h3" {...data} />
          ))}
        </ul>
      </section>
    )}

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block transition-transform duration-150 ease-out group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0 rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>
