---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection, type CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Layout from "@/layouts/Layout.astro";
import { Header, Footer, Breadcrumb, Main, Card } from "@/components";
import { postFilter } from "@/utils/postFilter";
import { resolveTimezone } from "@/utils/resolveTimezone";
import { getPostsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import { useTranslations } from "@/i18n";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });

// Group by the calendar day the post's byline shows (see Datetime.astro),
// not by the build machine's local zone.
const toLocalDate = (post: CollectionEntry<"posts">) =>
  dayjs(post.data.pubDatetime).tz(
    resolveTimezone(post.data.timezone ?? config.site.timezone)
  );

const sortByNewest = (
  a: CollectionEntry<"posts">,
  b: CollectionEntry<"posts">
) =>
  new Date(b.data.pubDatetime).getTime() -
  new Date(a.data.pubDatetime).getTime();

const posts = (await getCollection("posts")).filter(postFilter);

const groupedPosts = Object.entries(
  getPostsByGroupCondition(posts, post => toLocalDate(post).year())
)
  .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
  .map(([year, yearGroup]) => {
    const months = Object.entries(
      getPostsByGroupCondition(yearGroup, post => toLocalDate(post).month() + 1)
    )
      .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
      .map(([month, monthGroup]) => ({
        month: Number(month),
        label: monthFormatter.format(new Date(2000, Number(month) - 1, 1)),
        posts: [...monthGroup].sort(sortByNewest),
      }));

    return {
      year,
      total: yearGroup.length,
      months,
    };
  });
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    {groupedPosts.map(({ year, total, months }) => (
      <div>
        <span class="text-2xl font-bold">{year}</span>{" "}
        <sup class="text-muted-foreground text-sm">{total}</sup>
        {months.map(({ month, label, posts: monthPosts }) => (
          <div class="flex flex-col sm:flex-row" data-month={month}>
            <div class="mt-6 min-w-36 text-lg sm:my-6">
              <span class="font-bold">{label}</span>{" "}
              <sup class="text-muted-foreground text-xs">
                {monthPosts.length}
              </sup>
            </div>
            <ul>
              {monthPosts.map(data => (
                <Card {...data} />
              ))}
            </ul>
          </div>
        ))}
      </div>
    ))}
  </Main>

  <Footer />
</Layout>
