---
import { useTranslations } from "@/i18n";
import type { TocItem } from "@/utils/buildTocTree";
import TocNav from "./TocNav.astro";

type Props = { items: TocItem[] };

const { items } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

{
  items.length > 0 && (
    <aside class="toc-side" data-pagefind-ignore>
      <a href="#article" class="toc-skip">
        {t.a11y.skipTableOfContents}
      </a>
      <TocNav {items} labelId="toc-side-label" />
    </aside>
  )
}

<style is:global>
  .post-body {
    position: relative;
  }

  /* ---- list look (side, popover) ---- */
  :is(.toc-side, .toc-popover) ol {
    list-style: none;
    margin: 0;
    padding-inline-start: 1rem;
  }
  :is(.toc-side, .toc-popover) ol ol {
    color: color-mix(in oklab, var(--color-foreground) 80%, transparent);
  }
  :is(.toc-side, .toc-popover) li {
    margin-block: 0.375rem;
  }
  :is(.toc-side, .toc-popover) nav a {
    position: relative;
    display: inline-block;
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }
  :is(.toc-side, .toc-popover) nav a::before {
    content: "#";
    content: "#" / "";
    position: absolute;
    inset-inline-start: -0.75rem;
    opacity: 0.6;
  }
  [data-toc-nav] a:hover,
  [data-toc-nav] a[aria-current="true"] {
    color: var(--color-accent);
  }
  [data-toc-nav] a[aria-current="true"] {
    text-decoration: underline dashed;
    text-underline-offset: 4px;
  }
  .toc-label {
    flex-shrink: 0;
    padding-block-end: 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
  /* The label and Back to top stay put; only the list between them scrolls. */
  :is(.toc-side, .toc-popover) nav {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  :is(.toc-side, .toc-popover) nav > ol {
    position: relative;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  /* ---- side TOC (hidden below 80rem) ---- */
  /* Shows on focus, over the label, so keyboard users can jump to the article. */
  .toc-skip {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 1;
    padding: 0.125rem 0.25rem;
    background: var(--color-background);
    color: var(--color-accent);
    font-size: 0.875rem;
  }
  .toc-skip:not(:focus) {
    clip-path: inset(50%);
  }
  .toc-side {
    display: none;
  }
  .toc-side > nav {
    position: sticky;
    top: 2rem;
    max-height: calc(100dvh - 4rem);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .toc-back-to-top {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }
  .toc-back-to-top:hover {
    color: var(--color-accent);
  }
  :is(.toc-side, .toc-popover) .toc-back-to-top {
    flex-shrink: 0;
    margin-block-start: 0.5rem;
    padding-block: 0.5rem;
    border-radius: 0;
    border-block-start: 1px dashed var(--color-border);
  }

  /* The layout TOC replaces an author-written one (deprecated, see rehypeInlineToc). */
  .post-body:has(.toc-side) .toc-inline {
    display: none;
  }

  /* ---- beside the centred column (>= 80rem) ---- */
  @media (min-width: 80rem) {
    .toc-side {
      display: block;
      position: absolute;
      inset-block: 0;
      inset-inline-start: 100%;
      /* 100% is the post column, so a customised max-w-app still fits. A wide
         column leaves little space, so the gaps shrink to give the list more. */
      --toc-space: calc((100vw - 100%) / 2);
      --toc-gap: clamp(0.75rem, calc(var(--toc-space) - 14.5rem), 2.5rem);
      --toc-edge: clamp(0.75rem, calc(var(--toc-space) - 15.5rem), 1.5rem);
      margin-inline-start: var(--toc-gap);
      width: min(
        16rem,
        calc(var(--toc-space) - var(--toc-gap) - var(--toc-edge))
      );
      container-type: inline-size;
    }
    /* Too narrow to read, so the floating button takes over. */
    @container (width < 7.5rem) {
      .toc-side > nav,
      .toc-skip {
        display: none;
      }
    }
  }

  @media print {
    .toc-side {
      display: none !important;
    }
  }
</style>
