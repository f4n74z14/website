---
import IconPlay from "@/assets/icons/IconPlay.svg";
import IconPause from "@/assets/icons/IconPause.svg";
import IconSpinner from "@/assets/icons/IconSpinner.svg";
import IconExternalLink from "@/assets/icons/IconExternalLink.svg";
import IconX from "@/assets/icons/IconX.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale ?? config.site.lang);
---

<div
  id="music-player"
  data-open="false"
  data-i18n={JSON.stringify(t.music)}
  transition:persist="music-player"
  class="fixed inset-x-0 bottom-0 z-50"
  aria-hidden="true"
  inert
>
  <div
    class="border-t border-border bg-background/95 backdrop-blur-md"
    style="padding-bottom: env(safe-area-inset-bottom);"
  >
    <div class="music-controls mx-auto flex max-w-app items-center">
      <button
        id="music-play"
        type="button"
        disabled
        aria-label={t.music.play}
        class="music-icon-button"
      >
        <IconPlay id="music-play-icon" aria-hidden="true" />
        <IconPause id="music-pause-icon" aria-hidden="true" class="hidden" />
      </button>

      <span
        id="music-current"
        class="music-time text-right text-xs text-muted-foreground"
      >
        0:00
      </span>

      <div class="music-seek">
        <input
          id="music-progress"
          type="range"
          min="0"
          max="100"
          value="0"
          disabled
          aria-label={t.music.playbackPosition}
          class="music-range"
        />

        <span
          id="music-loading"
          class="pointer-events-none absolute inset-0 z-10 hidden items-center justify-center"
          role="status"
          aria-label={t.music.loading}
        >
          <IconSpinner
            class="size-3.5 animate-spin text-accent motion-reduce:animate-none"
            aria-hidden="true"
          />
        </span>
      </div>

      <span
        id="music-duration"
        class="music-time text-xs text-muted-foreground"
      >
        0:00
      </span>

      <input
        id="music-volume"
        type="range"
        min="0"
        max="1"
        step="0.01"
        aria-label={t.music.volume}
        class="music-range"
      />

      <a
        id="music-audius"
        href="https://audius.co/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.music.openOnAudius}
        title={t.music.openOnAudius}
        class="music-icon-button"
      >
        <IconExternalLink aria-hidden="true" />
      </a>

      <button
        id="music-close"
        type="button"
        aria-label={t.music.close}
        title={t.music.close}
        class="music-icon-button"
      >
        <IconX width={17} height={17} stroke-width="1.7" aria-hidden="true" />
      </button>
    </div>
  </div>
</div>

<audio id="music-audio" transition:persist="music-audio" preload="none"></audio>

<style is:global>
  :root {
    --music-player-height: 0px;
  }

  :root:has(#music-player[data-open="true"]) {
    --music-player-height: calc(53px + env(safe-area-inset-bottom));
  }

  @media (min-width: 640px) {
    :root:has(#music-player[data-open="true"]) {
      --music-player-height: calc(57px + env(safe-area-inset-bottom));
    }
  }

  body:has(#music-player) {
    padding-block-end: var(--music-player-height);
    transition: padding-block-end 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
</style>

<style>
  #music-player {
    transform: translate3d(0, 100%, 0);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 200ms ease,
      visibility 0s linear 280ms;
  }

  #music-player[data-open="true"] {
    transform: translate3d(0, 0, 0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 200ms ease,
      visibility 0s;
  }

  .music-controls {
    height: 56px;
    width: 100%;
    gap: 12px;
    padding-inline: 16px;
  }

  .music-time {
    width: 36px;
    flex: 0 0 36px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .music-seek {
    position: relative;
    display: flex;
    align-items: center;
    height: 32px;
    min-width: 48px;
    flex: 1 1 0%;
  }

  .music-icon-button {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    color: var(--muted-foreground);
    border-radius: 9999px;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      border-color 150ms ease,
      transform 150ms ease;
  }

  #music-play {
    border: 1px solid var(--border);
  }

  #music-player[data-error] #music-play {
    border-color: var(--accent);
    color: var(--accent);
  }

  .music-icon-button:hover:not(:disabled) {
    color: var(--accent);
    background-color: var(--muted);
    border-color: var(--accent);
  }

  .music-icon-button:active:not(:disabled) {
    transform: scale(0.92);
  }

  .music-icon-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .music-icon-button:disabled {
    cursor: wait;
    opacity: 0.5;
  }

  .music-range {
    display: block;
    height: 24px;
    min-width: 0;
    margin: 0;
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    cursor: pointer;
    touch-action: pan-y;
    --progress: 0%;
  }

  .music-range:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  #music-progress {
    width: 100%;
    flex: 1 1 auto;
  }

  #music-volume {
    width: 64px;
    flex: 0 0 64px;
  }

  .music-range::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      var(--accent) 0%,
      var(--accent) var(--progress),
      var(--border) var(--progress),
      var(--border) 100%
    );
  }

  .music-range::-webkit-slider-thumb {
    appearance: none;
    -webkit-appearance: none;
    width: 10px;
    height: 10px;
    margin-top: -3px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--background);
    transition: transform 150ms ease;
  }

  .music-range:hover:not(:disabled)::-webkit-slider-thumb {
    transform: scale(1.25);
  }

  .music-range::-moz-range-track {
    height: 4px;
    border: none;
    border-radius: 9999px;
    background: var(--border);
  }

  .music-range::-moz-range-progress {
    height: 4px;
    border-radius: 9999px;
    background: var(--accent);
  }

  .music-range::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--background);
    transition: transform 150ms ease;
  }

  .music-range:hover:not(:disabled)::-moz-range-thumb {
    transform: scale(1.25);
  }

  .music-range:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 9999px;
  }

  @media (max-width: 639px) {
    .music-controls {
      height: 52px;
      gap: 8px;
      padding-inline: 12px;
    }
    .music-time {
      width: 32px;
      flex-basis: 32px;
      font-size: 11px;
    }
    .music-seek {
      min-width: 40px;
    }
    #music-volume {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .music-controls {
      gap: 6px;
      padding-inline: 8px;
    }
    .music-time {
      width: 29px;
      flex-basis: 29px;
      font-size: 10px;
    }
    .music-seek {
      min-width: 32px;
    }
    .music-icon-button {
      width: 30px;
      height: 30px;
      flex-basis: 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(body:has(#music-player)),
    #music-player,
    .music-icon-button,
    .music-range::-webkit-slider-thumb,
    .music-range::-moz-range-thumb {
      transition: none;
    }
  }
</style>

<script>
  import "@/scripts/musicPlayer";
</script>
